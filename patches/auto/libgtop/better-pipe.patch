+/* Fork `argv` and connect its standard input/output to the given pipes.
+ * The child is added to `children` so that it can be reaped later on. */
+static pid_t
+run_filter (char *const argv[], const int in[2], const int out[2])
+{
+    pid_t pid = fork ();
+
+    if (pid < 0) {
+      g_warning ("fork failed: %s", g_strerror (errno));
+      return -1;
+    }
+
+    if (pid == 0) {
+      if (in)
+        dup2 (in[0], STDIN_FILENO);
+      if (out)
+        dup2 (out[1], STDOUT_FILENO);
+      _exit (execvp (argv[0], (char **) argv) == 0 ? 0 : 1);
+    }
+
+    return pid;
+}
+
+/* Reap a child that has (hopefully) already terminated, so that we do not
+ * leave a zombie process behind. */
+static void
+reap_child (pid_t pid)
+{
+    int status;
+
+    if (pid <= 0)
+      return;
+
+    while (waitpid (pid, &status, 0) < 0) {
+      if (errno != EINTR)
+        break;
+    }
+}
+
+void
+get_from_pipe (char *buffer, const size_t bufsiz)
+{
+    int pipe_lsblk[2];
+    int pipe_sed[2];
+    int pipe_tr[2];
+    pid_t children[3] = { -1, -1, -1 };
+
+    if (pipe (pipe_lsblk) < 0) {
+      g_warning ("pipe failed: %s", g_strerror (errno));
+      return;
+    }
+
+    {
+      char *argv[] = { "lsblk", "--output", "NAME,TYPE", "-i", "-n", NULL };
+
+      children[0] = run_filter (argv, NULL, pipe_lsblk);
+    }
+    close (pipe_lsblk[1]);
+
+    if (pipe (pipe_sed) < 0) {
+      g_warning ("pipe failed: %s", g_strerror (errno));
+      close (pipe_lsblk[0]);
+      reap_child (children[0]);
+      return;
+    }
+
+    {
+      char *argv[] = {
+          "sed",
+          "-e", "s/`-//",
+          "-e", "s/|-//",
+          "-e", "s/|//",
+          "-e", "s/^[ \t]*//",
+          NULL
+      };
+
+      children[1] = run_filter (argv, pipe_lsblk, pipe_sed);
+    }
+    close (pipe_lsblk[0]);
+    close (pipe_sed[1]);
+
+    if (pipe (pipe_tr) < 0) {
+      g_warning ("pipe failed: %s", g_strerror (errno));
+      close (pipe_sed[0]);
+      reap_child (children[0]);
+      reap_child (children[1]);
+      return;
+    }
+
+    {
+      char *argv[] = { "tr", "-s", " ", NULL };
+
+      children[2] = run_filter (argv, pipe_sed, pipe_tr);
+    }
+    close (pipe_sed[0]);
+    close (pipe_tr[1]);
+
+    if (children[0] < 0 || children[1] < 0 || children[2] < 0) {
+      close (pipe_tr[0]);
+      reap_child (children[0]);
+      reap_child (children[1]);
+      reap_child (children[2]);
+      return;
+    }
+
+    FILE* fp = fdopen(pipe_tr[0], "r");
+    size_t psize = fread(buffer,1,bufsiz, fp);
+    if (psize == bufsiz)
+      g_warning("Read bufsiz bytes, there may be more");
+
+    fclose(fp);
+    close(pipe_tr[0]);
+
+    /* Reading stops when the last filter exits, but the other processes are
+     * still around as zombies: wait for all of them. */
+    reap_child (children[0]);
+    reap_child (children[1]);
+    reap_child (children[2]);
+}
